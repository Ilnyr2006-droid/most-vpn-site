NEXT_PUBLIC_SITE_URL=https://example.com
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Runtime role: только SELECT/INSERT/UPDATE/DELETE, без CREATE TABLE/INDEX.
DATABASE_URL=
PGPOOL_MAX=5
# Deployment-only role с правами на DDL. Используется только npm run db:migrate.
DATABASE_MIGRATOR_URL=
# Reverse proxy должен удалить клиентское значение этого заголовка и установить свой секрет.
TRUSTED_PROXY_SECRET_HEADER=x-most-proxy-secret
TRUSTED_PROXY_HEADER_SECRET=
SUPPORT_URL=
# Случайный секрет не короче 32 символов для подписанной httpOnly-cookie гостевого чата.
SUPPORT_GUEST_SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Обязательный случайный секрет длиной не менее 32 символов. Без него admin-вход отключён.
ADMIN_SESSION_SECRET=

VERIFICATION_PROVIDER=mock
OTP_SECRET=
SESSION_SECRET=
AUTH_COOKIE_NAME=most_session
# Секрет не короче 32 символов для AES-256-GCM шифрования VPN-данных в БД.
CREDENTIAL_ENCRYPTION_KEY=
# Секрет не короче 32 символов для вызова POST /api/internal/provisioning/reconcile по расписанию.
PROVISIONING_CRON_SECRET=
# Секрет не короче 32 символов для POST /api/internal/monitoring/reconcile каждые 1-5 минут.
MONITORING_CRON_SECRET=
# URL webhook, который принимает JSON { text, service, state, detail, at }. Не коммитить реальный URL.
MONITORING_ALERT_WEBHOOK_URL=
# Через сколько секунд без heartbeat нода считается OFFLINE (60-900, по умолчанию 150).
VPN_HEARTBEAT_STALE_SECONDS=150
DEV_AUTH_BYPASS_ENABLED=false
# DEV_AUTH_BYPASS_PHONE задаётся только локально и не коммитится
